{"$type":"MixItUp.Base.Model.Overlay.Widgets.OverlayWidgetV3Model, MixItUp.Base","Name":"WoW Chat","Item":{"$type":"MixItUp.Base.Model.Overlay.OverlayChatV3Model, MixItUp.Base","BackgroundColor":"Wheat","BorderColor":"Black","MessageDelayTime":0,"MessageRemovalTime":0,"AddMessagesToTop":false,"HideExclamationMessages":false,"DisplayAlejoPronouns":false,"IgnoreSpecialtyExcludedUsers":false,"UsernamesToIgnore":[],"ShowPlatformBadge":true,"ShowRoleBadge":true,"ShowSubscriberBadge":true,"ShowSpecialtyBadge":true,"ApplicableStreamingPlatforms":[2],"MessageAddedAnimation":{"$type":"MixItUp.Base.Model.Overlay.OverlayAnimationV3Model, MixItUp.Base","StartTime":0.0,"AnimateCSSAnimation":0,"WoahCSSAnimation":0},"MessageRemovedAnimation":{"$type":"MixItUp.Base.Model.Overlay.OverlayAnimationV3Model, MixItUp.Base","StartTime":0.0,"AnimateCSSAnimation":0,"WoahCSSAnimation":0},"Text":null,"FontSize":24,"FontName":"Arial","FontColor":"Black","Bold":true,"Italics":false,"Underline":false,"TextAlignment":0,"ShadowColor":null,"Version":0,"OverlayEndpointID":"00000000-0000-0000-0000-000000000000","Type":12,"DisplayOption":1,"Width":400,"Height":600,"PositionType":0,"XPosition":25,"YPosition":50,"XMaximum":0,"YMaximum":0,"Layer":0,"OldCustomHTML":null,"ID":"9d0e44fa-c269-4d8a-a3de-62d9672b0ea1","HTML":"<script src=\"https://cdn.jsdelivr.net/npm/comfy.js@latest/dist/comfy.min.js\"></script>\r\n\r\n<div class=\"container\">\r\n  <div id=\"side-btns\">\r\n    <!-- Speaker button -->\r\n    <div class=\"wow-btn\" title=\"Sound\">\r\n      <svg viewBox=\"-2 0.5 29 29\" xmlns=\"http://www.w3.org/2000/svg\">\r\n        <defs><linearGradient id=\"g-snd\" gradientUnits=\"userSpaceOnUse\" x1=\"0\" y1=\"6\" x2=\"0\" y2=\"25\"><stop offset=\"0\" stop-color=\"#fff0a0\"></stop>\r\n          <stop offset=\"0.32\" stop-color=\"#ffe76b\"></stop>\r\n          <stop offset=\"0.48\" stop-color=\"#eec21e\"></stop>\r\n          <stop offset=\"0.6\" stop-color=\"#ce9608\"></stop>\r\n          <stop offset=\"1\" stop-color=\"#8f7005\"></stop>\r\n        </linearGradient>\r\n      </defs>\r\n        <rect x=\"2\" y=\"19\" width=\"3\" height=\"2\" fill=\"rgba(0,0,0,0.7)\"></rect>\r\n        <polygon points=\"2,12 5.5,12 10.5,6 12,6 12,25 10.5,25 5.5,19 2,19\" fill=\"url(#g-snd)\"></polygon>\r\n        <rect x=\"12\" y=\"8\" width=\"1\" height=\"17\" fill=\"rgba(0,0,0,0.7)\"></rect>\r\n        <rect x=\"18\" y=\"14\" width=\"1\" height=\"5\" fill=\"rgba(0,0,0,0.75)\"></rect>\r\n        <rect x=\"16.5\" y=\"19\" width=\"2\" height=\"1.5\" fill=\"rgba(0,0,0,0.65)\"></rect>\r\n        <rect x=\"16\" y=\"12\" width=\"2\" height=\"7\" fill=\"#f7db00\"></rect>\r\n        <path d=\"M17.5 6.5 A10.9 10.9 0 0 1 17.5 26.5\" fill=\"none\" stroke=\"rgba(0,0,0,0.7)\" stroke-width=\"2\"></path>\r\n        <path d=\"M16.5 5.5 A10.9 10.9 0 0 1 16.5 25.5\" fill=\"none\" stroke=\"#f7db00\" stroke-width=\"2.2\"></path>\r\n      </svg>\r\n    </div>\r\n    <!-- Chat button -->\r\n    <div class=\"wow-btn\" title=\"Chat\">\r\n      <svg viewBox=\"0 0 14 13\" xmlns=\"http://www.w3.org/2000/svg\">\r\n        <defs><linearGradient id=\"g-chat\" x1=\"0\" y1=\"1\" x2=\"1\" y2=\"0\">\r\n          <stop offset=\"0\" stop-color=\"#bda210\"></stop>\r\n          <stop offset=\"0.5\" stop-color=\"#d9c210\"></stop>\r\n          <stop offset=\"1\" stop-color=\"#efdb10\"></stop>\r\n        </linearGradient>\r\n      </defs>\r\n        <path d=\"M7 0.5 C10.8 0.5 13.5 2.3 13.5 4.6 C13.5 6.7 11.9 8.3 10.4 8.6 L11.7 12.9 L7.2 8.7 C3.4 8.5 0.5 6.7 0.5 4.6 C0.5 2.3 3.2 0.5 7 0.5 Z\" fill=\"url(#g-chat)\" stroke=\"#4d4212\" stroke-width=\"0.7\" stroke-linejoin=\"round\"></path>\r\n      </svg>\r\n    </div>\r\n    <!-- Scroll up button -->\r\n    <div class=\"wow-btn scroll\" title=\"Scroll Up\">\r\n      <svg viewBox=\"0 0 13 9\" xmlns=\"http://www.w3.org/2000/svg\">\r\n\r\n        <defs><linearGradient id=\"g-up\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\r\n          <stop offset=\"0\" stop-color=\"#e7c721\"></stop>\r\n          <stop offset=\"0.67\" stop-color=\"#bd9e10\"></stop>\r\n          <stop offset=\"1\" stop-color=\"#bd9e10\"></stop>\r\n        </linearGradient>\r\n      </defs>\r\n        <polygon points=\"6.5,0 13,6 9,6 9,9 4,9 4,6 0,6\" fill=\"url(#g-up)\"></polygon>\r\n        <polyline points=\"0.6,5.6 6.5,0.4 12.4,5.6\" fill=\"none\" stroke=\"#ecd02a\" stroke-width=\"0.7\" stroke-linejoin=\"round\"></polyline>\r\n        <rect x=\"4\" y=\"8.3\" width=\"5\" height=\"0.7\" fill=\"#967e10\"></rect>\r\n      </svg>\r\n    </div>\r\n    <!-- Scroll down button -->\r\n    <div class=\"wow-btn scroll\" title=\"Scroll Down\">\r\n      <svg viewBox=\"0 0 13 10\" xmlns=\"http://www.w3.org/2000/svg\">\r\n        <defs><linearGradient id=\"g-dn\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\r\n          <stop offset=\"0\" stop-color=\"#b59610\"></stop>\r\n          <stop offset=\"1\" stop-color=\"#8f7a08\"></stop>\r\n        </linearGradient>\r\n      </defs>\r\n        <rect x=\"4\" y=\"0\" width=\"5\" height=\"3.2\" fill=\"#b59610\"></rect>\r\n        <rect x=\"4\" y=\"0\" width=\"5\" height=\"0.8\" fill=\"#e7c729\"></rect>\r\n        <rect x=\"8.2\" y=\"0\" width=\"0.8\" height=\"3.2\" fill=\"#deba18\"></rect>\r\n        <polygon points=\"0,3 13,3 6.5,10\" fill=\"url(#g-dn)\"></polygon>\r\n        <rect x=\"8.5\" y=\"3\" width=\"4.5\" height=\"0.8\" fill=\"#deba18\"></rect>\r\n      </svg>\r\n    </div>\r\n    <!-- Scroll to bottom button -->\r\n    <div class=\"wow-btn scroll\" title=\"Scroll to Bottom\">\r\n      <svg viewBox=\"0 0 13 12\" xmlns=\"http://www.w3.org/2000/svg\">\r\n        <defs>\r\n          <linearGradient id=\"g-end\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\r\n            <stop offset=\"0\" stop-color=\"#a58a08\"></stop>\r\n            <stop offset=\"1\" stop-color=\"#8a7408\"></stop>\r\n          </linearGradient>\r\n        </defs>\r\n        <rect x=\"4\" y=\"0\" width=\"5\" height=\"3.2\" fill=\"#a58a08\"></rect>\r\n        <rect x=\"4\" y=\"0\" width=\"5\" height=\"0.8\" fill=\"#e7c729\"></rect>\r\n        <rect x=\"8.2\" y=\"0\" width=\"0.8\" height=\"3.2\" fill=\"#d6b418\"></rect>\r\n        <polygon points=\"0,3 13,3 6.5,10\" fill=\"url(#g-end)\"></polygon>\r\n        <rect x=\"8.5\" y=\"3\" width=\"4.5\" height=\"0.8\" fill=\"#d6b418\"></rect>\r\n        <rect x=\"0\" y=\"11\" width=\"7\" height=\"1\" fill=\"#9c8208\"></rect>\r\n        <rect x=\"7\" y=\"11\" width=\"6\" height=\"1\" fill=\"#bd9e10\"></rect>\r\n      </svg>\r\n    </div>\r\n  </div>\r\n\r\n    <div id=\"chat\">\r\n        <ul>\r\n        </ul>\r\n    </div>\r\n</div>","CSS":"html,body {\r\n      margin: 0;\r\n      padding: 0;\r\n      font-family: Arial Narrow;\r\n      color: rgb(31, 104, 132);\r\n    }\r\n\r\n    blockquote {\r\n      margin: 0px;\r\n    }\r\n\r\n    .wow-btn {\r\n    width: 30px;\r\n    height: 30px;\r\n    background: rgba(14, 14, 12, 1);\r\n    border: 1px solid;\r\n    border-color: #9c9e9c #84827b #4a4942 #524d4a;\r\n    border-radius: 3px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    flex-shrink: 0;\r\n    margin-bottom: 20px;\r\n    margin-right: 5px;\r\n    box-shadow: inset 0 1px 0 rgba(0, 0, 0, 1), inset 0 -1px 0 rgba(0, 0, 0, 1), inset 1px 0 0 rgba(0, 0, 0, 1), inset -1px 0 0 rgba(0, 0, 0, 1), inset 0 2px 0 rgba(57, 55, 57, 0.80), inset 0 3px 0 rgba(66, 64, 66, 0.67), inset 2px 0 0 rgba(0, 0, 0, 0.60), inset 0 -2px 0 rgba(0, 0, 0, 0.60), inset -2px 0 0 rgba(48, 47, 46, 0.80), 0 0 0 1px rgba(0, 0, 0, 0.53), 0 0 0 2px rgba(0, 0, 0, 0.20);\r\n    }\r\n\r\n    .container {\r\n      display: flex;\r\n      flex-direction: row;\r\n      align-items: flex-end;\r\n      gap: 1px;\r\n      padding: 5px;\r\n    }\r\n\r\n    #chat {\r\n      width: 800px;\r\n      height: 350px;\r\n      overflow-y: auto;\r\n      display: flex;\r\n      flex-direction: column-reverse;\r\n      background-color: rgba(0, 0, 0, 1);\r\n      margin-bottom: 10px;\r\n      border-radius: 5px;\r\n      outline: solid rgb(144, 144, 144, 1);\r\n    }\r\n\r\n    #chat ul {\r\n      list-style-type: none;\r\n      list-style-position: outside;\r\n      display: flex;\r\n      flex-direction: column;\r\n      margin: 5px;\r\n      padding: 5px;\r\n      gap: 4px;\r\n\r\n      /* Colours for various user flags */\r\n      li.guild { \r\n        color: rgb(64, 255, 64);\r\n      }\r\n      li.officer {\r\n        color: rgb(64, 192, 64);\r\n      }\r\n      li.blizz {\r\n        color: rgb(4, 248, 238);\r\n      }\r\n      li.gen {\r\n        color: rgb(255, 192, 192);\r\n      }\r\n      li.raidwarn{\r\n        color: rgb(255, 72, 0);\r\n      }\r\n      li.raidlead{\r\n        color: rgb(255, 72, 9);\r\n      }\r\n      li.raid{\r\n        color: rgb(255, 127, 0);\r\n      }\r\n      li.join{\r\n        color: rgb(255, 255, 0);\r\n      }\r\n      li.usersay{\r\n        color: rgb(255, 255, 255);\r\n      }\r\n      li.yell{\r\n        color: rgb(255, 64, 64);\r\n      }\r\n      li.party{\r\n        color: rgb(170, 170, 255);\r\n      }\r\n      li.partyleader{\r\n        color: rgb(118, 200, 255);\r\n      }\r\n      li.common{\r\n        color: rgb(255, 255, 255);\r\n      }\r\n      li.uncommon{\r\n        color: rgb(30, 255, 0);\r\n      }\r\n      li.rare{\r\n        color: rgb(0, 112, 221);\r\n      }\r\n      .epic{\r\n        color: rgb(163, 53, 238);\r\n      }\r\n      .legendary{\r\n        color: rgb(255, 128, 0);\r\n      }\r\n      .loot{\r\n        color: rgb(0, 170, 0);\r\n      }\r\n    }\r\n\r\n    #chat::-webkit-scrollbar {\r\n      display: none;\r\n    }\r\n    #chat blockquote {\r\n      font-size: 1.5rem;\r\n    }\r\n","Javascript":"var streamer = \"$streamerusername\";\r\n    //The channel you want to connect to\r\nvar broadcaster = \"blizz\";\r\nvar subscriber = \"guild\";\r\nvar mod = \"officer\";\r\nvar highlight = \"yell\";\r\nvar chatter = \"gen\";\r\n      /*\r\n        This defines what you want different roles to appear as.\r\n        available appearances are: usersay, gen, partyleader, party,\r\n        raidlead, raid, guild, officer, yell, gen, blizz.\r\n      */\r\n\r\n(function() {\r\n        let chat = document.querySelector(\"#chat>ul\");\r\n        console.log(chat);\r\n        let newMessage = document.createElement(\"li\");\r\n        let text  = document.createElement(\"blockquote\");\r\n        text.innerText = ( streamer + \" has come online.\");\r\n        newMessage.classList.add('join');\r\n        newMessage.append(text);\r\n        chat.append(newMessage);\r\n\r\n        function legitem (message) \r\n      {\r\n              const result = message.replace(/\\[([^\\]]+)\\]/g, '<span class=\"legendary\">[$1]</span>');\r\n              return result;\r\n      }\r\n\r\n      ComfyJS.onChat = (user, message, flags, self, extra) => {\r\n                let newMessage = document.createElement(\"li\");\r\n                let text  = document.createElement(\"blockquote\");\r\n\r\n              if( message.includes(\"[\") && message.includes(\"]\")){\r\n                message = legitem(message);\r\n              }\r\n              \r\n                if( flags.highlighted ){\r\n                  newMessage.classList.add(highlight);\r\n                }\r\n                else if ( flags.broadcaster ){\r\n                  newMessage.classList.add(broadcaster);\r\n                }\r\n                else if( flags.mod ){\r\n                  newMessage.classList.add(mod);\r\n                }\r\n                else if( flags.subscriber ){\r\n                  newMessage.classList.add(subscriber);\r\n                }\r\n                else{\r\n                  newMessage.classList.add(chatter);\r\n                }\r\n\r\n                if( newMessage.classList.contains(\"yell\") ){\r\n                  text.innerHTML = (\"[\" + user + \"] yells: \" + message);\r\n                }\r\n                else if ( newMessage.classList.contains(\"blizz\") ){\r\n                 text.innerHTML = (\"[\" + user + \"] whispers: \" + message);\r\n                }\r\n                else if( newMessage.classList.contains(\"officer\") ){\r\n                  text.innerHTML = (\"[Officer] [\" + user + \"]: \" + message);\r\n                }\r\n                else if( newMessage.classList.contains(\"guild\") ){\r\n                  text.innerHTML = (\"[Guild] [\" + user + \"]: \" + message);\r\n                }\r\n                else if( newMessage.classList.contains(\"partyleader\") ){\r\n                  text.innerHTML = (\"[Party Leader] [\" + user + \"]: \" + message);\r\n                }\r\n                else if( newMessage.classList.contains(\"party\") ){\r\n                  text.innerHTML = (\"[Party] [\" + user + \"]: \" + message);\r\n                }\r\n                else if( newMessage.classList.contains(\"raidlead\") ){\r\n                  text.innerHTML = (\"[Raid Leader] [\" + user + \"]: \" + message);\r\n                }\r\n                else if( newMessage.classList.contains(\"raid\") ){\r\n                  text.innerHTML = (\"[Raid] [\" + user + \"]: \" + message);\r\n                }\r\n                else if ( newMessage.classList.contains(\"usersay\") ){\r\n                 text.innerHTML = (\"[\" + user + \"] says: \" + message);\r\n                }\r\n                else{\r\n                  text.innerHTML = (\"[1. General] [\" + user + \"]: \" + message);\r\n                }\r\n\r\n        \r\n\r\n                newMessage.append(text);\r\n                newMessage.id = extra.id;\r\n                chat.append(newMessage);\r\n      }\r\n\r\n      ComfyJS.onRaid = (user, viewers, extra) => {\r\n        let newMessage = document.createElement(\"li\");\r\n        let text = document.createElement(\"blockquote\");\r\n        text.innerText = ( \"[Raid Warning] \" + user + \" is raiding with \" + viewers + \"!\");\r\n        newMessage.classList.add('raidwarn');\r\n        newMessage.append(text);\r\n        chat.append(newMessage);\r\n      }\r\n\r\n      ComfyJS.onSub = ( user, message, subTierInfo, extra) => {\r\n        let newMessage = document.createElement(\"li\");\r\n        let text = document.createElement(\"blockquote\");\r\n        text.innerText = ( user + \" has joined the guild.\");\r\n        newMessage.classList.add('join');\r\n        newMessage.append(text);\r\n        chat.append(newMessage);\r\n      }\r\n\r\n      ComfyJS.onResub = ( user, message, streamMonths, cumulativeMonths, subTierInfo, extra) => {\r\n        let newMessage = document.createElement(\"li\");\r\n        let text = document.createElement(\"blockquote\");\r\n        let secondMes = document.createElement(\"li\");\r\n        let secondTex = document.createElement(\"blockquote\");\r\n\r\n        text.innerText = ( user + \" has come online.\");\r\n        newMessage.classList.add('join');\r\n        newMessage.append(text);\r\n        chat.append(newMessage);\r\n\r\n        secondTex.innerText = ( \"[\" + user + \"]: \" + message );\r\n        secondMes.classList.add(subscriber);\r\n        secondMes.append(secondTex);\r\n        chat.append(secondMes);\r\n      }\r\n\r\n      ComfyJS.onSubGift = ( gifterUser, streakMonths, recipientUser, senderCount, subTierInfo, extra ) => {\r\n        let newMessage = document.createElement(\"li\");\r\n        let text = document.createElement(\"blockquote\");\r\n        text.innerHTML = ( recipientUser + \" receives loot: \" + \"<span class='epic'>[Gifted Sub]</span>\");\r\n        newMessage.classList.add('loot');\r\n        newMessage.append(text);\r\n        chat.append(newMessage);\r\n      }\r\n\r\n      ComfyJS.onCheer = ( user, message, bits, flags, extra) => {\r\n        let newMessage = document.createElement(\"li\");\r\n        let text = document.createElement(\"blockquote\");\r\n        let secondMes = document.createElement(\"li\");\r\n        let secondTex = document.createElement(\"blockquote\");\r\n        \r\n\r\n        if (bits < 50){\r\n        text.innerHTML = ( \"<span class='loot'>\" + streamer + \" receives loot: </span>\" + \"[\"+ bits +\" bits]\");\r\n        newMessage.classList.add('common');\r\n        }\r\n        else if (bits >= 50 && bits < 250){\r\n        text.innerHTML = (\"<span class='loot'>\" + streamer + \" receives loot: </span>\" + \"[\"+ bits +\" bits]\");\r\n        newMessage.classList.add('uncommon');\r\n        }\r\n        else if (bits >= 250 && bits < 500){\r\n        text.innerHTML = (\"<span class='loot'>\" + streamer + \" receives loot: </span>\" + \"[\"+ bits +\" bits]\");\r\n        newMessage.classList.add('rare');\r\n        }\r\n        else if (bits >= 500 && bits < 1000){\r\n        text.innerHTML = (\"<span class='loot'>\" + streamer + \" receives loot: </span>\" + \"[\"+ bits +\" bits]\");\r\n        newMessage.classList.add('epic');\r\n        }\r\n        else if (bits >= 1000){\r\n        text.innerHTML = (\"<span class='loot'>\" + streamer + \" receives loot: </span>\" + \"[\"+ bits +\" bits]\");\r\n        newMessage.classList.add('legendary');\r\n        }\r\n\r\n        secondTex.innerText = (\"[\" + user + \"] says: \" + message);\r\n        secondMes.classList.add('userSay');\r\n        secondMes.append(secondTex);\r\n        chat.append(secondMes);\r\n\r\n        newMessage.append(text);\r\n        chat.append(newMessage);\r\n\r\n      }\r\n\r\n    ComfyJS.onMessageDeleted = (id, extra) => {\r\n     let delMes = document.getElementById(id);\r\n     delMes.remove();\r\n    }\r\n\r\n\r\n    //commands for testing. \r\n    //Set to only work if the broadcaster sends the command \r\n      \r\n      ComfyJS.onCommand = ( user, command, message, flags, extra ) => {\r\n        if( flags.broadcaster && command === \"testraid\" ) {\r\n          ComfyJS.onRaid(\"testuser\", \"50\", null);\r\n        }\r\n        else if( flags.broadcaster && command === \"testsub\" ) {\r\n          ComfyJS.onSub(\"testuser\", \"I subbed!\", null, null);\r\n        }\r\n        else if( flags.broadcaster && command === \"testresub\" ) {\r\n          ComfyJS.onResub(\"testuser\", \"I resubbed!\", null, null, null, null);\r\n        }\r\n        else if( flags.broadcaster && command === \"testgiftsub\" ) {\r\n          ComfyJS.onSubGift(\"testsenduser\", \"5\", \"testreceiveuser\", null, null, null);\r\n        }\r\n        else if( flags.broadcaster && command === \"testbits\" ) {\r\n          ComfyJS.onCheer(\"testsenduser\", \"Message\", \"25\", null, null, null);\r\n          ComfyJS.onCheer(\"testsenduser\", \"Message\", \"50\", null, null, null);\r\n          ComfyJS.onCheer(\"testsenduser\", \"Message\", \"250\", null, null, null);\r\n          ComfyJS.onCheer(\"testsenduser\", \"Message\", \"500\", null, null, null);\r\n          ComfyJS.onCheer(\"testsenduser\", \"Message\", \"1000\", null, null, null);\r\n        }\r\n        else if( flags.broadcaster && command === \"roletest\" ) {\r\n          broadcaster = message;\r\n        }\r\n      }\r\n      ComfyJS.Init(streamer);\r\n\r\n      })();"},"IsEnabled":false,"RefreshTime":0}